{
  "name": "react-scoped-styles",
  "private": true,
  "workspaces": [
    "packages/*/*",
    "demo/*/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1"
  },
  "devDependencies": {
    "turbo": "^1.13.4"
  },
  "pnpm": {
    "overrides": {
      "postcss-modules-scope": "3.1.1",
      "postcss-modules-local-by-default": "4.0.4"
    }
  }
}
